{
  "expo": {
    "name": "GenSentiel",
    "slug": "gensentiel",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gensentiel",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow GenSentiel to take progress photos."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.gensentiel.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.gensentiel.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "VIBRATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1c3ef781-3110-4979-b0cc-b1d0858b5ed2"
      }
    }
  }
}
